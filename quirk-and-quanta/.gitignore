.pytest_cache/
.coverage
.coverage.*
.cache
.tox/
.mypy_cache/

# Node.js / NPM / Web Artifacts
node_modules/
*.log

# Firebase & Cloud Tooling Ephemera
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Secrets, API Keys & Sensitive Credentials
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.cert
*.crt
*service-account*.json
*presenter-key*.txt

# IDEs, Text Editors & Local Configuration
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

